# Ассистент оболочки glass: Claude по API (запасной — локальная модель llama-server), Whisper, Silero.
# Ставится в ~/.config/systemd/user/. Ключ Claude API — в ~/.config/glass/assistant.env:
#   ANTHROPIC_API_KEY=sk-ant-...
[Unit]
Description=glass assistant (Claude + Whisper + Silero)
After=pipewire.service

[Service]
Type=simple
EnvironmentFile=-%h/.config/glass/assistant.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=%h/.local/share/glass-assistant/app
ExecStart=%h/.local/share/glass-assistant/venv/bin/python -m glass_assistant serve
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
